# Copy to .env (setup.sh does it) and chmod 600. Read by run.sh and by the systemd service.
# Values with spaces or JSON must be quoted.

# Public address of the site, no trailing slash. Google sign-in needs https and a real domain name.
SCIC_BASE_URL=https://3d.example.com

# The one Google account allowed into /admin
SCIC_ADMIN_EMAIL=waynescicluna.1985@gmail.com

# Optional: license emails
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=you@example.com
#SMTP_PASSWORD=app-password
#SMTP_FROM="Scic3D <you@example.com>"

# Optional: Stripe upgrades (see DEPLOY.md)
#STRIPE_SECRET_KEY=sk_live_xxx
#STRIPE_WEBHOOK_SECRET=whsec_xxx
#SCIC_PRICES='{"PRO:1m":"price_123","PRO:1y":"price_456","ENTERPRISE:1y":"price_789"}'
